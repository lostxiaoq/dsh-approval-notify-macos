{
  "name": "dsh-approval-notify-macos",
  "version": "0.1.3",
  "description": "DeepSeek Harness 插件（macOS）：每次需要审批时发系统通知，点击跳回 dsh；只提醒，不作答。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "approval",
    "notification",
    "macos"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "author": "lostxiaoq",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lostxiaoq/dsh-approval-notify-macos.git"
  },
  "homepage": "https://github.com/lostxiaoq/dsh-approval-notify-macos#readme",
  "bugs": {
    "url": "https://github.com/lostxiaoq/dsh-approval-notify-macos/issues"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "test": "node --test tests/accept/*.test.mjs"
  }
}
